<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^public/ - [L]
    RewriteRule ^index\.php(/.*)?$ - [L]

    RewriteRule ^$ index.php [L]

    RewriteCond %{DOCUMENT_ROOT}/result/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/result/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
